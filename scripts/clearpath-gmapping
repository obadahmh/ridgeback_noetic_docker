#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
docker compose run --rm noetic bash -lc '
  set -euo pipefail
  source /home/obadah/ws/devel/setup.bash
  echo "Starting Clearpath ridgeback_navigation gmapping only."
  echo "This follows the gmapping include used by gmapping_demo.launch, without starting move_base."
  echo
  roslaunch "$(rospack find ridgeback_navigation)/launch/include/gmapping.launch" scan_topic:=/front/scan
'
