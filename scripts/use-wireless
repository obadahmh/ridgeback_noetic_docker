#!/usr/bin/env bash
set -euo pipefail

robot_ip="${1:-}"
offboard_ip="${2:-}"

if [ -z "$robot_ip" ] || [ -z "$offboard_ip" ]; then
  echo "Usage: ./scripts/use-wireless ROBOT_WIFI_IP OFFBOARD_WIFI_IP"
  echo
  echo "Example:"
  echo "  ./scripts/use-wireless 10.180.68.123 10.180.68.46"
  exit 2
fi

cd "$(dirname "$0")/.."

cat > .env <<EOF
ROBOT_IP=${robot_ip}
OFFBOARD_IP=${offboard_ip}
ROBOT_HOSTNAME=cpr-r100-0601
EOF

echo "Configured Docker ROS networking for wireless:"
cat .env
