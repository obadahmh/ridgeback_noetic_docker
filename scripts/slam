#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

xhost +local:root >/dev/null 2>&1 || true
xhost +local:"$(whoami)" >/dev/null 2>&1 || true

docker compose run --rm noetic bash -lc '
  set -euo pipefail
  source /home/obadah/ws/devel/setup.bash

  echo "Starting Clearpath Ridgeback gmapping and RViz."
  echo "RViz is using ridgeback_viz/rviz/gmapping.rviz."
  echo "Drive slowly in another terminal with ./scripts/teleop."
  echo "Save in a third terminal while this window is still running:"
  echo "  ./scripts/save-map first_floor"
  echo

  roslaunch "$(rospack find ridgeback_navigation)/launch/include/gmapping.launch" scan_topic:=/front/scan &

  gmapping_pid="$!"

  cleanup() {
    kill "$gmapping_pid" >/dev/null 2>&1 || true
    wait "$gmapping_pid" >/dev/null 2>&1 || true
  }
  trap cleanup EXIT INT TERM

  sleep 2
  rviz -d "$(rospack find ridgeback_viz)/rviz/gmapping.rviz"
'
