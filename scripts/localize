#!/usr/bin/env bash
set -euo pipefail

map_yaml="${1:-maps/lab_floor.yaml}"

cd "$(dirname "$0")/.."

docker compose run --rm noetic bash -lc '
  set -euo pipefail
  source /home/obadah/ws/devel/setup.bash

  map_yaml="$1"

  echo "Starting map_server and AMCL."
  echo "Map: $map_yaml"
  echo "Use RViz 2D Pose Estimate to give AMCL the robot start pose."
  echo

  rosrun map_server map_server "$map_yaml" &
  map_server_pid="$!"

  cleanup() {
    kill "$map_server_pid" >/dev/null 2>&1 || true
    wait "$map_server_pid" >/dev/null 2>&1 || true
  }
  trap cleanup EXIT INT TERM

  sleep 1
  roslaunch "$(rospack find ridgeback_navigation)/launch/include/amcl.launch" scan_topic:=/front/scan
' _ "/home/obadah/ws/${map_yaml}"
