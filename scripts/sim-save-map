#!/usr/bin/env bash
set -euo pipefail

name="${1:-sim_map_$(date +%Y%m%d_%H%M%S)}"

cd "$(dirname "$0")/.."

docker compose run --rm \
  -e ROS_MASTER_URI=http://127.0.0.1:11311 \
  -e ROS_IP=127.0.0.1 \
  -e ROS_HOSTNAME= \
  noetic bash -lc '
    set -euo pipefail
    name="$1"
    mkdir -p /home/obadah/ws/maps
    rosrun map_server map_saver -f "/home/obadah/ws/maps/${name}"
    echo
    echo "Saved simulated map files:"
    ls -lh "/home/obadah/ws/maps/${name}.pgm" "/home/obadah/ws/maps/${name}.yaml"
  ' _ "$name"
