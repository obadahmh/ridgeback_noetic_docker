#!/usr/bin/env bash
set -euo pipefail

duration="${1:-60}"

cd "$(dirname "$0")/.."
host_log_root="$(pwd)/ws/logs"

docker compose run --rm noetic bash -lc "
  set -euo pipefail

  stamp=\"\$(date +%Y%m%d_%H%M%S)\"
  log_dir=\"\$HOME/ws/logs/record_\$stamp\"
  mkdir -p \"\$log_dir\"

  echo \"Recording Ridgeback diagnostics for ${duration}s.\"
  echo \"Reproduce the shutdown now, then let this finish or press Ctrl-C.\"
  echo \"Logs will be under: \$log_dir\"

  rostopic list > \"\$log_dir/topics.txt\" || true
  rosnode list > \"\$log_dir/nodes.txt\" || true

  timeout ${duration} rosbag record \
    -O \"\$log_dir/ridgeback_diagnostics.bag\" \
    /diagnostics \
    /diagnostics_agg \
    /diagnostics_toplevel_state \
    /mcu/status \
    /status \
    /feedback \
    /e_stop \
    /cmd_vel \
    /ridgeback_velocity_controller/cmd_vel \
    /ridgeback_velocity_controller/odom \
    /odometry/filtered \
    /tf \
    /tf_static \
    || true

  echo
  echo \"Done. Host path:\"
  echo \"${host_log_root}/record_\$stamp\"
"
